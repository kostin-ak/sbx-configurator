#!/bin/sh /etc/rc.common
# OpenWrt procd service for the staged sing-box-extended runtime.

START=99
STOP=10
USE_PROCD=1

NAME=sing-box-extended
PROG=/data/sbx/current/bin/sing-box-extended
CONFIG=/data/sbx/current/build/artifacts/config.json
WORKDIR=/data/sbx/state/main
LOGDIR=/data/sbx/state/main/logs

start_service() {
	[ -x "$PROG" ] || {
		echo "ERROR: sing-box-extended binary is absent: $PROG" >&2
		return 1
	}
	[ -f "$CONFIG" ] || {
		echo "ERROR: candidate config is absent: $CONFIG" >&2
		return 1
	}

	mkdir -p "$WORKDIR" "$LOGDIR"
	umask 077
	"$PROG" check -c "$CONFIG" -D "$WORKDIR" || return 1

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONFIG" -D "$WORKDIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "$WORKDIR/procd.pid"
	procd_close_instance
}

reload_service() {
	stop
	start
}
